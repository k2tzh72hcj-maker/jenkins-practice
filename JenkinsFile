pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Building...'
                sh 'date'
            }
        }
        stage('Test') {
            steps {
                echo 'Testing...'
                sh 'whoami'
            }
        }
        stage('Deploy') {
            steps {
                echo 'Building Docker image...'
                sh 'docker build -t hello-jenkins-image .'
                sh 'docker images | grep hello-jenkins-image'
            }
        }
    }
     post { 
        always { 
            echo 'Cleaning images...!'
            sh 'docker image prune -f'
            }
        }
}
